import React, { useState, useEffect } from 'react';
import { LineChart, XAxis, YAxis, Tooltip, Legend, Line, ResponsiveContainer } from 'recharts';
import { AlertCircle, Play, Apple, Download, Settings, Moon, Sun, Eye, Volume2, VolumeX, HelpCircle } from 'lucide-react';
import { Alert, AlertDescription, AlertTitle } from '@/components/ui/alert';

const ZooSimulator = () => {
  const [state, setState] = useState({
    hour: 1,
    animals: [],
    healthHistory: [],
    settings: {
      soundEnabled: true,
      darkMode: false,
      highContrast: false
    }
  });

  const [showTutorial, setShowTutorial] = useState(true);
  const [showSettings, setShowSettings] = useState(false);
  const [selectedAnimal, setSelectedAnimal] = useState(null);
  const [alerts, setAlerts] = useState([]);

  useEffect(() => {
    initializeZoo();
  }, []);

  const initializeZoo = () => {
    const defaultAnimals = [
      ...Array(5).fill().map((_, i) => ({ 
        id: i + 1, 
        name: `Monkey ${i + 1}`, 
        type: 'Monkey', 
        health: 100, 
        happiness: 100,
        lastFed: 1,
        playingStreak: 0
      })),
      ...Array(5).fill().map((_, i) => ({ 
        id: i + 6, 
        name: `Giraffe ${i + 1}`, 
        type: 'Giraffe', 
        health: 100, 
        happiness: 100,
        lastFed: 1
      })),
      ...Array(5).fill().map((_, i) => ({ 
        id: i + 11, 
        name: `Elephant ${i + 1}`, 
        type: 'Elephant', 
        health: 100, 
        happiness: 100,
        lastFed: 1,
        canWalk: true
      }))
    ];
    setState(prev => ({ ...prev, animals: defaultAnimals }));
  };

  const addAlert = (message, type = 'info') => {
    const newAlert = { id: Date.now(), message, type };
    setAlerts(prev => [...prev, newAlert]);
    setTimeout(() => {
      setAlerts(prev => prev.filter(alert => alert.id !== newAlert.id));
    }, 5000);
  };

  const passTime = () => {
    setState(prev => {
      const newAnimals = prev.animals.map(animal => {
        let health = animal.health;
        let happiness = animal.happiness;
        const healthDecrease = Math.random() * 20;
        
        health = Math.max(0, health - healthDecrease);
        happiness = Math.max(0, happiness - (healthDecrease / 2));

        // Special behaviors
        if (animal.type === 'Monkey' && health > 90) {
          health -= 5; // Playing reduces health
          happiness += 10;
          addAlert(`${animal.name} is playing! Entertainment value increased!`, 'success');
        }

        if (animal.type === 'Elephant' && health < 70) {
          addAlert(`${animal.name} can't walk! Health critical!`, 'warning');
        }

        // Death conditions
        if ((animal.type === 'Monkey' && health < 30) ||
            (animal.type === 'Giraffe' && health < 50) ||
            (animal.type === 'Elephant' && health < 70 && !animal.canWalk)) {
          addAlert(`${animal.name} has passed away`, 'error');
          return null;
        }

        return { ...animal, health, happiness };
      }).filter(Boolean);

      return {
        ...prev,
        hour: prev.hour + 1,
        animals: newAnimals
      };
    });
  };

  const feedAnimals = () => {
    setState(prev => ({
      ...prev,
      animals: prev.animals.map(animal => {
        const healthIncrease = 10 + Math.random() * 15;
        return {
          ...animal,
          health: Math.min(100, animal.health + healthIncrease),
          happiness: Math.min(100, animal.happiness + (healthIncrease / 2)),
          lastFed: prev.hour
        };
      })
    }));
    addAlert('All animals have been fed!', 'success');
  };

  const exportData = () => {
    const data = {
      hour: state.hour,
      animals: state.animals,
      averageHealth: calculateAverageHealth()
    };
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `zoo-data-hour-${state.hour}.json`;
    a.click();
    URL.revokeObjectURL(url);
  };

  const calculateAverageHealth = () => {
    if (!state.animals.length) return 0;
    return Math.round(state.animals.reduce((sum, animal) => sum + animal.health, 0) / state.animals.length);
  };

  return (
    <div className="min-h-screen bg-gray-50 dark:bg-gray-900 transition-colors duration-200">
      <nav className="bg-white dark:bg-gray-800 shadow-sm">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
          <div className="flex justify-between items-center">
            <div className="flex items-center space-x-4">
              <h1 className="text-2xl font-bold text-gray-900 dark:text-white">🦁 Zoo Simulator</h1>
              <span className="px-3 py-1 rounded-full bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-100">
                Hour: {state.hour}
              </span>
            </div>
            <div className="flex items-center space-x-2">
              <button 
                onClick={() => setState(prev => ({ ...prev, settings: { ...prev.settings, soundEnabled: !prev.settings.soundEnabled }}))}
                className="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700"
              >
                {state.settings.soundEnabled ? <Volume2 size={20} /> : <VolumeX size={20} />}
              </button>
              <button
                onClick={() => setState(prev => ({ ...prev, settings: { ...prev.settings, darkMode: !prev.settings.darkMode }}))}
                className="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700"
              >
                {state.settings.darkMode ? <Sun size={20} /> : <Moon size={20} />}
              </button>
              <button
                onClick={() => setState(prev => ({ ...prev, settings: { ...prev.settings, highContrast: !prev.settings.highContrast }}))}
                className="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700"
              >
                <Eye size={20} />
              </button>
              <button
                onClick={() => setShowTutorial(true)}
                className="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700"
              >
                <HelpCircle size={20} />
              </button>
              <button
                onClick={() => setShowSettings(true)}
                className="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700"
              >
                <Settings size={20} />
              </button>
            </div>
          </div>
        </div>
      </nav>

      <main className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div className="flex flex-wrap gap-4 mb-8">
          <button
            onClick={passTime}
            className="flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700"
          >
            <Play size={16} className="mr-2" /> Pass Time
          </button>
          <button
            onClick={feedAnimals}
            className="flex items-center px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700"
          >
            <Apple size={16} className="mr-2" /> Feed Animals
          </button>
          <button
            onClick={exportData}
            className="flex items-center px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700"
          >
            <Download size={16} className="mr-2" /> Export Data
          </button>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
          <div className="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
            <h2 className="text-xl font-semibold mb-4">Zoo Summary</h2>
            <div className="grid grid-cols-3 gap-4">
              <div className="text-center">
                <div className="text-3xl font-bold text-blue-600">{state.animals.length}</div>
                <div className="text-sm text-gray-500">Total Animals</div>
              </div>
              <div className="text-center">
                <div className="text-3xl font-bold text-green-600">{calculateAverageHealth()}%</div>
                <div className="text-sm text-gray-500">Average Health</div>
              </div>
              <div className="text-center">
                <div className="text-3xl font-bold text-red-600">
                  {state.animals.filter(a => 
                    (a.type === 'Monkey' && a.health < 40) ||
                    (a.type === 'Giraffe' && a.health < 60) ||
                    (a.type === 'Elephant' && a.health < 80)
                  ).length}
                </div>
                <div className="text-sm text-gray-500">Critical Animals</div>
              </div>
            </div>
          </div>

          <div className="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
            <h2 className="text-xl font-semibold mb-4">Health Trends</h2>
            <div className="h-64">
              <ResponsiveContainer width="100%" height="100%">
                <LineChart data={state.healthHistory}>
                  <XAxis dataKey="hour" />
                  <YAxis />
                  <Tooltip />
                  <Legend />
                  <Line type="monotone" dataKey="averageHealth" stroke="#2563eb" />
                </LineChart>
              </ResponsiveContainer>
            </div>
          </div>
        </div>

        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {state.animals.map(animal => (
            <div 
              key={animal.id}
              className="bg-white dark:bg-gray-800 rounded-lg shadow p-6 cursor-pointer hover:shadow-lg transition-shadow"
              onClick={() => setSelectedAnimal(animal)}
            >
              <div className="flex justify-between items-start mb-4">
                <div>
                  <h3 className="text-lg font-semibold">{animal.name}</h3>
                  <p className="text-sm text-gray-500">{animal.type}</p>
                </div>
                {animal.type === 'Monkey' && animal.health > 90 && (
                  <span className="px-2 py-1 bg-yellow-100 text-yellow-800 rounded-full text-xs">Playing</span>
                )}
              </div>
              <div className="space-y-4">
                <div>
                  <div className="flex justify-between mb-1">
                    <span className="text-sm font-medium">Health</span>
                    <span className="text-sm text-gray-500">{Math.round(animal.health)}%</span>
                  </div>
                  <div className="w-full bg-gray-200 rounded-full h-2">
                    <div 
                      className={`rounded-full h-2 ${
                        animal.health > 70 ? 'bg-green-600' :
                        animal.health > 40 ? 'bg-yellow-600' :
                        'bg-red-600'
                      }`}
                      style={{ width: `${animal.health}%` }}
                    />
                  </div>
                </div>
                <div>
                  <div className="flex justify-between mb-1">
                    <span className="text-sm font-medium">Happiness</span>
                    <span className="text-sm text-gray-500">{Math.round(animal.happiness)}%</span>
                  </div>
                  <div className="w-full bg-gray-200 rounded-full h-2">
                    <div 
                      className="bg-blue-600 rounded-full h-2"
                      style={{ width: `${animal.happiness}%` }}
                    />
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </main>

      <div className="fixed bottom-4 right-4 space-y-2">
        {alerts.map(alert => (
          <Alert key={alert.id} className={`${
            alert.type === 'error' ? 'bg-red-50 border-red-200' :
            alert.type === 'warning' ? 'bg-yellow-50 border-yellow-200' :
            alert.type === 'success' ? 'bg-green-50 border-green-200' :
            'bg-blue-50 border-blue-200'
          } w-96`}>
            <AlertCircle className={`${
              alert.type === 'error' ? 'text-red-600' :
              alert.type === 'warning' ? 'text-yellow-600' :
              alert.type === 'success' ? 'text-green-600' :
              'text-blue-600'
            } h-4 w-4`} />
            <AlertTitle>{alert.type.charAt(0).toUpperCase() + alert.type.slice(1)}</AlertTitle>
            <AlertDescription>{alert.message}</AlertDescription>
          </Alert>
        ))}
      </div>
    </div>
  );
};

export default ZooSimulator;
